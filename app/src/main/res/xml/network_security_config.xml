<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The app itself only uses HTTPS (Gecko has its own network stack and HTTPS-only mode).
         User-installed CAs are NOT trusted (system CAs only). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
